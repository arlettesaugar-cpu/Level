                ${fixMojibake(img.title)}
              </div>
            </div>
          `).join('')}
        </div>
      </div>
    </div>
  `;
}

/* 2. MÓDULO RESERVAS & CANCHAS (2 CANCHAS DE PÁDEL) */
function fixMojibake(str) {
  if (typeof str !== 'string' || !str) return str || '';
  return str
    .replace(/\u00C2\u00AA/g, 'ª')
    .replace(/\u00C3\u00AA/g, 'ª')
    .replace(/2Âª/g, '2ª')
    .replace(/3Âª/g, '3ª')
    .replace(/Âª/g, 'ª')
    .replace(/2Ãª/g, '2ª')
    .replace(/3Ãª/g, '3ª')
    .replace(/Ãª/g, 'ª')
    .replace(/PÃ;del/gi, 'Pádel')
    .replace(/PÃ¡del/gi, 'Pádel')
    .replace(/PÃdel/gi, 'Pádel')
    .replace(/PÃ;/g, 'Pá')
    .replace(/PÃ¡/g, 'Pá')
    .replace(/PÃ/g, 'Pá')
    .replace(/TacÃ;mbaro/gi, 'Tacámbaro')
    .replace(/TacÃ¡mbaro/gi, 'Tacámbaro')
    .replace(/TacÃmbaro/gi, 'Tacámbaro')
    .replace(/MichoacÃ;n/gi, 'Michoacán')
    .replace(/MichoacÃ¡n/gi, 'Michoacán')
    .replace(/MichoacÃn/gi, 'Michoacán')
    .replace(/PanorÃ;mica/gi, 'Panorámica')
    .replace(/PanorÃ¡mica/gi, 'Panorámica')
    .replace(/CategorÃ;a/gi, 'Categoría')
    .replace(/CategorÃa/gi, 'Categoría')
    .replace(/PrÃ;ximamente/gi, 'Próximamente')
    .replace(/PrÃ³ximamente/gi, 'Próximamente')
    .replace(/PrÃximamente/gi, 'Próximamente')
    .replace(/\u00C2/g, '')
    .replace(/Â/g, '')
    .replace(/Ã;/g, 'á')
    .replace(/Ã¡/g, 'á')
    .replace(/Ã©/g, 'é')
    .replace(/Ã­/g, 'í')
    .replace(/Ã³/g, 'ó')
    .replace(/Ãº/g, 'ú')
    .replace(/Ã±/g, 'ñ')
    .replace(/Ã/g, 'Á');
}

